{
  "name": "forge-project",
  "version": "0.1.0",
  "description": "Unified cross-platform gamer identity desktop app",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "vite build && electron-builder",
    "electron": "electron .",
    "electron:wait": "wait-on tcp:5173 && npm run electron",
    "start": "concurrently -k -s first \"npm:dev\" \"npm:electron:wait\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^17.4.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true
  }
}
